    <!-- Bootstrap -->
    <link href="<%= ResolveUrl("~/Styles/bootstrap.min.css") %>" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/Styles/fontawesome.css")%>" rel="stylesheet" />
    <link href="<%= ResolveUrl("~/Styles/solid.css")%>" rel="stylesheet" />
